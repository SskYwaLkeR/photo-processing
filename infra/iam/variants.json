{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadMaster",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::aragon-photos-demo/work/*/*/master.jpg"
    },
    {
      "Sid": "WriteServedVariants",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::aragon-photos-demo/variants/*"
    },
    {
      "Sid": "MissingIs404",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::aragon-photos-demo",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "work/*"
          ]
        }
      }
    }
  ]
}
