{
  "name": "@pipeline/core",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "db:migrate": "node --env-file=../../.env ./node_modules/prisma/build/index.js migrate dev",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test --test-reporter=spec 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-presigned-post": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@prisma/client": "^6.19.0",
    "sharp": "^0.35.4",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
