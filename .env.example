# Postgres 16 (local, brew). The queue lives here too.
DATABASE_URL=postgresql://YOUR_OS_USER@localhost:5432/aragon_pipeline
PORT=4000

# S3 — private bucket. Dev uses one credential with infra/iam-policy.dev.json;
# production gives each service its own role from infra/iam/*.json.
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# Operator endpoint (/api/admin/stats). Empty = endpoint disabled (404).
ADMIN_TOKEN=change-me

# Admission control (backpressure at the edge)
# USER_MAX_IN_FLIGHT=100
# GLOBAL_MAX_IN_FLIGHT=400

# Workers (per replica). Defaults: convert 1, compress 2, variants 2.
# WORKER_CONCURRENCY=
# WORKER_LEASE_MS=30000
# WORKER_TASK_TIMEOUT_MS=120000
# WORKER_MAX_ATTEMPTS=3
# SHARP_THREADS=2

# Limits
# MAX_BYTES=52428800
# MAX_INPUT_PIXELS=100000000

# Demo failure injection: make one stage throw transient errors (restart that stage to toggle)
# CHAOS_FAIL_STAGE=compress
# CHAOS_FAIL_RATE=1
